# Copy to backend/.env on the server. Never commit backend/.env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SENTRY_DSN=
# 32-byte key, hex-encoded. Used only to encrypt identity data at rest.
DATA_ENCRYPTION_KEY=
# Demo one-click login is off unless this is exactly true.
ALLOW_DEMO=false
# Set true only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=false
PORT=3000
# Prototype email/phone codes. Refused when NODE_ENV=production. Leave unset in production.
# VERIFICATION_PROTOTYPE=false
# Optional. When exactly "all", publishing and booking require a completed verification record.
# Existing accounts stay able to publish and book unless this is set.
# VERIFICATION_GATE=
# Server-only reviewer key. Not a product role. Leave unset unless a reviewer process is configured.
# VERIFICATION_REVIEWER_KEY=
# Publish gate: "prohibited" blocks only prohibited items. "risk" also holds unidentified items. Default prohibited.
# SALIF_PUBLISH_GATE=prohibited
# Leave unset. A named provider is not a connection; no vision, OCR, or market adapter is bundled.
# VISION_PROVIDER=
# OCR_PROVIDER=
# MARKET_PROVIDER=
# Comma-separated HTTPS hosts. Empty means market collection does not fetch.
# MARKET_SOURCE_ALLOWLIST=
# Dev-only mock. Ignored when NODE_ENV=production. It does not invent prices or identity matches.
# AI_DEV_MOCK=false
# Claims reviewer key. Not a product role. Leave unset.
# PROTECTION_REVIEWER_KEY=
